{
  "name": "Sanecta",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd sanecta-backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev",
      "description": "Spring Boot API on http://localhost:8080 (Swagger UI at /swagger-ui.html)."
    },
    {
      "name": "frontend",
      "command": "cd sanecta-frontend && npm run dev",
      "description": "Next.js dev server on http://localhost:3000."
    }
  ],
  "ports": [
    { "name": "frontend", "port": 3000 },
    { "name": "backend", "port": 8080 }
  ]
}
